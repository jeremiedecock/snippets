<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>[[ app_title ]]</title>
  <style>
    body   { font-family: system-ui, sans-serif; max-width: 34rem;
             margin: 3rem auto; padding: 0 1rem; line-height: 1.5;
             color: #1a1a1a; }
    h1     { font-size: 1.6rem; }
    p.hint { color: #555; font-size: .9rem; }
    code   { background: #f0f0f0; padding: .1rem .3rem; border-radius: 3px; }
    #message { font-size: 1.5rem; font-weight: 600; padding: 1rem;
               border-radius: 6px; background: #f0f0f0; }
    #message.ok    { background: #e7f5e7; }
    #message.error { background: #fdeaea; font-size: 1rem; font-weight: 400; }
    button { font: inherit; padding: .4rem .8rem; cursor: pointer; }
  </style>
</head>
<body>
  <h1>[[ app_title ]]</h1>
  <p class="hint">
    [[ app_description ]]. This page is static, served by nginx under
    <code>/</code>; the message below comes from the backend under
    <code>[[ api_prefix ]]/</code>, on this same host.
  </p>

  <p id="message">loading…</p>
  <p><button id="refresh">Reload</button></p>

  <script>
    const messageEl = document.getElementById("message");

    async function load() {
      messageEl.className = "";
      messageEl.textContent = "loading…";
      try {
        // Relative URL: same origin as this page, so no CORS anywhere.
        const response = await fetch("[[ api_prefix ]]/", { cache: "no-store" });
        if (!response.ok) {
          throw new Error("HTTP " + response.status + " " + response.statusText);
        }
        const data = await response.json();
        messageEl.className = "ok";
        messageEl.textContent = data.message;
      } catch (error) {
        messageEl.className = "error";
        messageEl.textContent = "the backend did not answer: " + error.message;
      }
    }

    document.getElementById("refresh").addEventListener("click", load);
    load();
  </script>
</body>
</html>
