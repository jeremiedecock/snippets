apiVersion: apps/v1
kind: Deployment
metadata:
  name: frontend
  namespace: [[ namespace ]]
  labels:
    app.kubernetes.io/name: [[ app_slug ]]
    app.kubernetes.io/component: frontend
spec:
  replicas: [[ frontend_replicas ]]
  revisionHistoryLimit: 3
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 0
      maxSurge: 1
  selector:
    matchLabels:
      app: frontend
  template:
    metadata:
      labels:
        app: frontend
        app.kubernetes.io/name: [[ app_slug ]]
        app.kubernetes.io/component: frontend
    spec:
      securityContext:
        runAsNonRoot: true
        # UID of the nginx-unprivileged image.
        runAsUser: 101
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: frontend
          image: [[ registry ]]/[[ registry_owner ]]/[[ app_slug ]]-frontend:[[ version ]]
          imagePullPolicy: IfNotPresent
          ports:
            # 8080, not 80: the unprivileged nginx image binds a high port.
            - containerPort: 8080
              name: http
              protocol: TCP

          readinessProbe:
            httpGet:
              path: /
              port: http
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /
              port: http
            initialDelaySeconds: 10
            periodSeconds: 20

          resources:
            requests:
              cpu: 10m
              memory: 32Mi
            limits:
              memory: 128Mi

          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]

          # Everything nginx writes at runtime, on tmpfs.
          volumeMounts:
            - name: tmp
              mountPath: /tmp
            - name: cache
              mountPath: /var/cache/nginx
            - name: run
              mountPath: /var/run

      volumes:
        - name: tmp
          emptyDir: {}
        - name: cache
          emptyDir: {}
        - name: run
          emptyDir: {}

      imagePullSecrets:
        - name: [[ pull_secret ]]
