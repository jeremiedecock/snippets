#!/bin/sh

# claude.sh - OPTION 2: containerized Claude Code authenticated with a
#             LONG-LIVED OAuth TOKEN (`claude setup-token`), shared across
#             projects through an environment variable.
#
# This file was generated by Copier (https://copier.readthedocs.io/) from the
# "option 2" template; the values below come from your answers, recorded in
# .copier-answers.yml. Run `copier update` in this project to re-sync with a
# newer version of the template.
#
# ---------------------------------------------------------------------------
# How this option works
# ---------------------------------------------------------------------------
# `claude setup-token` performs the interactive OAuth procedure ONCE and
# generates a long-lived token (valid ~1 year, requires a Claude Pro/Max/Team/
# Enterprise subscription — this is subscription auth, NOT an API key). Claude
# Code then authenticates through the CLAUDE_CODE_OAUTH_TOKEN environment
# variable, with no login flow at all. Official documentation:
#   https://code.claude.com/docs/en/authentication.md#generate-a-long-lived-token
# (The same mechanism is what the docs recommend for CI and Codespaces.)
#
# This script stores the token in a small host file (default:
# ~/.config/claude-containers/token, mode 600) and injects it into every
# container with `-e CLAUDE_CODE_OAUTH_TOKEN`. Run `./claude.sh --setup-token`
# once to generate and save it.
#
# Unlike Option 1 (fully shared ~/.claude), each project here keeps its OWN
# state volume, mounted on /home/user/.claude (= CLAUDE_CONFIG_DIR): history,
# sessions, folder trust and permissions stay isolated per project — only the
# authentication is shared. Because state is per-project, all projects can
# safely mount their workspace on the same /workspace path (no cross-project
# key collision, unlike Option 1).
#
# What remains per NEW project: the small first-run onboarding (theme +
# folder trust, a couple of keypresses) — not the ~10-click OAuth procedure.
#
# CAVEATS:
# - The token file is a plaintext secret (like any stored credential):
#   mode 600, keep it out of backups you do not trust. Anyone with the token
#   can use your Claude subscription until it expires or is revoked.
# - The token expires after ~1 year: re-run `./claude.sh --setup-token`.
# - Credential precedence: ANTHROPIC_API_KEY (and ANTHROPIC_AUTH_TOKEN) take
#   precedence over CLAUDE_CODE_OAUTH_TOKEN inside the container and would
#   silently switch you to API billing. This script forwards only the
#   variables it lists, so a stray host ANTHROPIC_API_KEY is NOT forwarded.
#   C.f. https://code.claude.com/docs/en/authentication.md#authentication-precedence
#
# Run `./claude.sh --help` for usage.
# ---------------------------------------------------------------------------

set -eu

PROJECT_DIR="$(cd "$(dirname "$0")" && pwd)"

# ---- Values filled in by Copier (see .copier-answers.yml) -----------------
PROJECT_NAME="{{ project_name }}"
IMAGE="${CLAUDE_IMAGE:-{{ image_name }}}"
# Per-project state volume (history, sessions, settings — NOT the auth).
STATE_VOLUME="${CLAUDE_STATE_VOLUME:-{{ state_volume }}}"
# Long-lived token file, shared by all projects.
TOKEN_FILE="${CLAUDE_TOKEN_FILE:-{{ token_file }}}"
# ---------------------------------------------------------------------------

CONTAINERFILE="containers/claude.containerfile"
CONTAINER_UID=1000
CONTAINER_GID=1000

usage() {
    cat <<EOF
Usage:
  ./claude.sh [CLAUDE_ARGS...]     Start Claude Code (all args are passed to claude)
  ./claude.sh --setup-token        Generate the long-lived token (once, for all projects)
  ./claude.sh --shell [ARGS...]    Start a bash shell in the container instead
  ./claude.sh --build              Force a rebuild of the image (also updates Claude Code)
  ./claude.sh -- [CLAUDE_ARGS...]  Pass args verbatim to claude (e.g. ./claude.sh -- --help)
  ./claude.sh --help               Show this help

Option 2: long-lived OAuth token (claude setup-token), per-project state.
  - Token file shared by ALL projects: ${TOKEN_FILE}
    (override with the CLAUDE_TOKEN_FILE environment variable)
  - Per-project state volume: ${STATE_VOLUME}
    (override with the CLAUDE_STATE_VOLUME environment variable)
  - Image (override with CLAUDE_IMAGE): ${IMAGE}

The token is valid ~1 year (Claude Pro/Max subscription required).
To revoke/renew: rm ${TOKEN_FILE} then ./claude.sh --setup-token
To wipe this project's state: podman volume rm ${STATE_VOLUME}
EOF
}

build_image() {
    echo "==> Building image ${IMAGE}..."
    # CACHEBUST only invalidates the 'install Claude Code' layer of the
    # containerfile, so rebuilding always fetches the latest Claude Code CLI
    # without redoing the apt layers.
    podman build \
        --build-arg CACHEBUST="$(date +%s)" \
        -t "${IMAGE}" \
        -f "${PROJECT_DIR}/${CONTAINERFILE}" \
        "${PROJECT_DIR}"
}

ensure_image() {
    podman image exists "${IMAGE}" || build_image
}

ensure_volume() {
    if ! podman volume exists "${STATE_VOLUME}"; then
        echo "==> Creating per-project state volume ${STATE_VOLUME}..."
        podman volume create "${STATE_VOLUME}" >/dev/null
    fi
}

# Export CLAUDE_CODE_OAUTH_TOKEN from the token file, unless the caller
# already provides it through the environment.
load_token() {
    if [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]; then
        return 0
    fi
    if [ -f "${TOKEN_FILE}" ]; then
        CLAUDE_CODE_OAUTH_TOKEN="$(cat "${TOKEN_FILE}")"
        export CLAUDE_CODE_OAUTH_TOKEN
    fi
}

# Warn when neither a token nor a stored per-project login is available
# (claude will then fall back to the interactive OAuth login).
check_auth() {
    if [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]; then
        return 0
    fi
    _mountpoint="$(podman volume inspect --format '{% raw %}{{.Mountpoint}}{% endraw %}' "${STATE_VOLUME}" 2>/dev/null)" || return 0
    [ -d "${_mountpoint}" ] || return 0  # remote Podman: cannot check from the host
    if [ ! -f "${_mountpoint}/.credentials.json" ]; then
        echo "==> No long-lived token (${TOKEN_FILE}) and no stored login for this project:"
        echo "    Claude Code will ask you to authenticate for THIS project only."
        echo "    Tip: run './claude.sh --setup-token' once to authenticate ALL projects."
    fi
}

# Run `claude setup-token` interactively in the container, then save the
# pasted token to TOKEN_FILE (mode 600). One-time, valid for all projects.
setup_token() {
    if [ ! -t 0 ]; then
        echo "ERROR: --setup-token requires an interactive terminal." >&2
        exit 1
    fi
    ensure_image
    ensure_volume
    echo "==> Running 'claude setup-token' in the container."
    echo "    Follow the OAuth procedure (Claude Pro/Max subscription required),"
    echo "    then copy the generated token (it looks like sk-ant-oat01-...)."
    echo
    podman run --rm -it \
        --hostname "${PROJECT_NAME}" \
        --userns="keep-id:uid=${CONTAINER_UID},gid=${CONTAINER_GID}" \
        -v "${PROJECT_DIR}:/workspace:z" \
        -v "${STATE_VOLUME}:/home/user/.claude" \
        "${IMAGE}" claude setup-token || true
    echo
    printf "Paste the generated token here (leave empty to abort): "
    IFS= read -r _token
    if [ -z "${_token}" ]; then
        echo "Aborted: no token saved."
        exit 1
    fi
    case "${_token}" in
        sk-ant-*) ;;
        *) echo "WARNING: the token does not start with 'sk-ant-' — saving it anyway." ;;
    esac
    mkdir -p "$(dirname "${TOKEN_FILE}")"
    # umask 077 => the file is created with mode 600 (owner-only secret)
    (umask 077; printf '%s\n' "${_token}" > "${TOKEN_FILE}")
    echo "==> Token saved to ${TOKEN_FILE} (mode 600)."
    echo "    All projects using this script now authenticate automatically."
}

run_in_container() {
    # Allocate a pseudo-TTY only when stdin is a terminal, so that piping into
    # the script keeps working (e.g. `git diff | ./claude.sh -p "review this"`).
    if [ -t 0 ]; then _tty_flag="-it"; else _tty_flag="-i"; fi

    # Forward the host git identity: the container has no ~/.gitconfig and the
    # home directory is not persisted.
    _git_name="$(git config --get user.name 2>/dev/null || true)"
    _git_email="$(git config --get user.email 2>/dev/null || true)"
    if [ -n "${_git_name}" ]; then
        export GIT_AUTHOR_NAME="${_git_name}" GIT_COMMITTER_NAME="${_git_name}"
    fi
    if [ -n "${_git_email}" ]; then
        export GIT_AUTHOR_EMAIL="${_git_email}" GIT_COMMITTER_EMAIL="${_git_email}"
    fi

    # - the per-project state volume is mounted on /home/user/.claude, which
    #   is CLAUDE_CONFIG_DIR in the image;
    # - a bare `-e VAR` forwards VAR into the container only when it is set,
    #   so CLAUDE_CODE_OAUTH_TOKEN is injected only when a token is available
    #   (and its value never appears on the podman command line);
    # - ':z' labels the bind mount for SELinux hosts (no-op elsewhere).
    exec podman run --rm "${_tty_flag}" \
        --hostname "${PROJECT_NAME}" \
        --userns="keep-id:uid=${CONTAINER_UID},gid=${CONTAINER_GID}" \
        -v "${PROJECT_DIR}:/workspace:z" \
        -v "${STATE_VOLUME}:/home/user/.claude" \
        -e CLAUDE_CODE_OAUTH_TOKEN \
        -e GIT_AUTHOR_NAME -e GIT_AUTHOR_EMAIL \
        -e GIT_COMMITTER_NAME -e GIT_COMMITTER_EMAIL \
        -e COLORTERM \
        "${IMAGE}" "$@"
}

command -v podman >/dev/null 2>&1 || { echo "ERROR: podman not found." >&2; exit 1; }

case "${1:-}" in
    -h|--help)
        usage
        ;;
    --build)
        build_image
        ;;
    --setup-token)
        setup_token
        ;;
    --shell)
        shift
        ensure_image
        ensure_volume
        load_token
        check_auth
        run_in_container bash "$@"
        ;;
    --)
        shift
        ensure_image
        ensure_volume
        load_token
        check_auth
        run_in_container claude "$@"
        ;;
    *)
        ensure_image
        ensure_volume
        load_token
        check_auth
        run_in_container claude "$@"
        ;;
esac
