#!/bin/sh

# https://github.com/jeremiedecock/snippets/tree/master/llm/claude_code_cli
#
# claude.sh - OPTION 1: containerized Claude Code with a SHARED authentication
#             directory bind-mounted from the host.
#
# This file was generated by Copier (https://copier.readthedocs.io/) from the
# "option 1" template; the values below come from your answers, recorded in
# .copier-answers.yml. Run `copier update` in this project to re-sync with a
# newer version of the template.
#
# ---------------------------------------------------------------------------
# How this option works
# ---------------------------------------------------------------------------
# All projects generated from this template share a single host directory
# (default: ~/.config/claude-containers/), bind-mounted on /home/user/.claude
# in every container. The image sets CLAUDE_CONFIG_DIR=/home/user/.claude, so
# that one directory holds ALL Claude Code state: the OAuth token
# (.credentials.json), the account/onboarding state (.claude.json), settings
# and history.
#
# You therefore authenticate ONCE, for all your projects — the same experience
# as non-containerized Claude Code, where a single ~/.claude serves every
# project directory on the machine. Token refreshes happen in this single
# store, so there is no risk of diverging credential copies.
#
# This mirrors the official devcontainer guidance (a shared config volume +
# CLAUDE_CONFIG_DIR):
#   https://code.claude.com/docs/en/devcontainer.md#persist-authentication-and-settings-across-rebuilds
#   https://code.claude.com/docs/en/authentication.md#credential-management
# A host directory is used here instead of a named volume so that the
# credentials survive `podman volume prune`, and are easy to inspect/back up.
#
# UNIQUE WORKSPACE PATH PER PROJECT: Claude Code keys its per-project state
# (history, `--continue`/`--resume`, folder trust, permissions) on the working
# directory path. Since the config directory is shared, every project must be
# mounted on a UNIQUE path — hence the /workspace/<project-name> value below.
# Otherwise all projects would share the same key and `claude --continue` in
# project A could resume a conversation from project B.
#
# What remains per-project: the folder-trust question on first run (a single
# keypress, once per project) — not the full OAuth procedure.
#
# SECURITY NOTE: any code running in any of these containers can read the
# shared token — the same trust model as non-containerized Claude Code. If you
# run untrusted code with `--dangerously-skip-permissions`, keep that in mind.
#
# CONCURRENCY: several containers using the shared directory at the same time
# is equivalent to several Claude Code terminals on one machine — supported.
#
# Run `./claude.sh --help` for usage.
# ---------------------------------------------------------------------------

set -eu

PROJECT_DIR="$(cd "$(dirname "$0")" && pwd)"

# ---- Values filled in by Copier (see .copier-answers.yml) -----------------
PROJECT_NAME="{{ project_name }}"
IMAGE="${CLAUDE_IMAGE:-{{ image_name }}}"
# Shared authentication/state directory on the host; MUST be the same for all
# projects (that is what makes the login shared).
CLAUDE_HOST_DIR="${CLAUDE_CONTAINERS_DIR:-{{ claude_host_dir }}}"
# Unique mount path for THIS project inside the container (see header).
CONTAINER_WORKSPACE="{{ container_workspace }}"
# ---------------------------------------------------------------------------

CONTAINERFILE="containers/claude.containerfile"
CONTAINER_UID=1000
CONTAINER_GID=1000

usage() {
    cat <<EOF
Usage:
  ./claude.sh [CLAUDE_ARGS...]     Start Claude Code (all args are passed to claude)
  ./claude.sh --shell [ARGS...]    Start a bash shell in the container instead
  ./claude.sh --build              Force a rebuild of the image (also updates Claude Code)
  ./claude.sh -- [CLAUDE_ARGS...]  Pass args verbatim to claude (e.g. ./claude.sh -- --help)
  ./claude.sh --help               Show this help

Option 1: shared authentication directory (host bind-mount).
  - Auth store shared by ALL projects: ${CLAUDE_HOST_DIR}
    (override with the CLAUDE_CONTAINERS_DIR environment variable)
  - This project is mounted on the unique path: ${CONTAINER_WORKSPACE}
  - Image (override with CLAUDE_IMAGE): ${IMAGE}

Authentication is asked once, for all projects sharing the directory.
To force a new authentication for all projects:
  rm -f ${CLAUDE_HOST_DIR}/.credentials.json
To wipe all shared Claude Code state (settings, history, token):
  rm -rf ${CLAUDE_HOST_DIR}
EOF
}

build_image() {
    echo "==> Building image ${IMAGE}..."
    # CACHEBUST only invalidates the 'install Claude Code' layer of the
    # containerfile, so rebuilding always fetches the latest Claude Code CLI
    # without redoing the apt layers.
    podman build \
        --build-arg CACHEBUST="$(date +%s)" \
        -t "${IMAGE}" \
        -f "${PROJECT_DIR}/${CONTAINERFILE}" \
        "${PROJECT_DIR}"
}

ensure_image() {
    podman image exists "${IMAGE}" || build_image
}

ensure_claude_dir() {
    if [ ! -d "${CLAUDE_HOST_DIR}" ]; then
        echo "==> Creating shared Claude Code directory ${CLAUDE_HOST_DIR}..."
        mkdir -p "${CLAUDE_HOST_DIR}"
        chmod 700 "${CLAUDE_HOST_DIR}"  # contains the OAuth token
    fi
}

# Warn when no OAuth token is stored yet (claude will then ask to log in).
check_auth() {
    if [ ! -f "${CLAUDE_HOST_DIR}/.credentials.json" ]; then
        echo "==> No stored token in ${CLAUDE_HOST_DIR}:"
        echo "    Claude Code will ask you to authenticate — only once, for ALL"
        echo "    projects sharing this directory."
    fi
}

run_in_container() {
    # Allocate a pseudo-TTY only when stdin is a terminal, so that piping into
    # the script keeps working (e.g. `git diff | ./claude.sh -p "review this"`).
    if [ -t 0 ]; then _tty_flag="-it"; else _tty_flag="-i"; fi

    # Forward the host git identity: the container has no ~/.gitconfig and the
    # home directory is not persisted.
    _git_name="$(git config --get user.name 2>/dev/null || true)"
    _git_email="$(git config --get user.email 2>/dev/null || true)"
    if [ -n "${_git_name}" ]; then
        export GIT_AUTHOR_NAME="${_git_name}" GIT_COMMITTER_NAME="${_git_name}"
    fi
    if [ -n "${_git_email}" ]; then
        export GIT_AUTHOR_EMAIL="${_git_email}" GIT_COMMITTER_EMAIL="${_git_email}"
    fi

    # - the project is mounted on a UNIQUE path (see header) and -w makes it
    #   the working directory (overrides the image's WORKDIR /workspace);
    # - the shared host directory is mounted on /home/user/.claude, which is
    #   also CLAUDE_CONFIG_DIR in the image;
    # - ':z' labels the mounts for SELinux hosts (no-op elsewhere);
    # - a bare `-e VAR` forwards VAR into the container only when it is set.
    exec podman run --rm "${_tty_flag}" \
        --hostname "${PROJECT_NAME}" \
        --userns="keep-id:uid=${CONTAINER_UID},gid=${CONTAINER_GID}" \
        -v "${PROJECT_DIR}:${CONTAINER_WORKSPACE}:z" \
        -v "${CLAUDE_HOST_DIR}:/home/user/.claude:z" \
        -w "${CONTAINER_WORKSPACE}" \
        -e GIT_AUTHOR_NAME -e GIT_AUTHOR_EMAIL \
        -e GIT_COMMITTER_NAME -e GIT_COMMITTER_EMAIL \
        -e COLORTERM \
        "${IMAGE}" "$@"
}

command -v podman >/dev/null 2>&1 || { echo "ERROR: podman not found." >&2; exit 1; }

case "${1:-}" in
    -h|--help)
        usage
        ;;
    --build)
        build_image
        ;;
    --shell)
        shift
        ensure_image
        ensure_claude_dir
        check_auth
        run_in_container bash "$@"
        ;;
    --)
        shift
        ensure_image
        ensure_claude_dir
        check_auth
        run_in_container claude "$@"
        ;;
    *)
        ensure_image
        ensure_claude_dir
        check_auth
        run_in_container claude "$@"
        ;;
esac
